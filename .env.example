# ─── OpenVPN ──────────────────────────────────────────────────────────────────
# Public IP or hostname that VPN clients connect to.
# Leave blank to auto-detect during add-user (tries api.ipify.org).
OPENVPN_SERVER_IP=

OPENVPN_PORT=1194
OPENVPN_PROTO=udp

OPENVPN_NETWORK=10.8.0.0
OPENVPN_NETMASK=255.255.255.0

OPENVPN_DNS1=1.1.1.1
OPENVPN_DNS2=8.8.8.8

# ─── PKI ──────────────────────────────────────────────────────────────────────
EASYRSA_KEY_SIZE=4096
EASYRSA_CA_EXPIRE=3650
EASYRSA_CERT_EXPIRE=825

# ─── Web Management UI ────────────────────────────────────────────────────────
# Port the web UI is accessible on (default: 8080)
WEBAPP_PORT=8080

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-in-production

# Set to 1 for development only
FLASK_DEBUG=0

# Disable authentication entirely (set to 1 only when the UI is behind a
# trusted reverse proxy or firewall and not publicly reachable)
AUTH_DISABLED=0

# ─── Supabase (admin auth + audit log) ────────────────────────────────────────
# Copy from your Supabase project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
