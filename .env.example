# ─── OpenVPN ──────────────────────────────────────────────────────────────────
# Public IP or hostname that VPN clients connect to.
# Leave blank to auto-detect during add-user (tries api.ipify.org — an
# outbound query to a third party; set this to avoid it).
OPENVPN_SERVER_IP=

OPENVPN_PORT=1194
OPENVPN_PROTO=udp

OPENVPN_NETWORK=10.8.0.0
OPENVPN_NETMASK=255.255.255.0

OPENVPN_DNS1=1.1.1.1
OPENVPN_DNS2=8.8.8.8

# ─── PKI ──────────────────────────────────────────────────────────────────────
EASYRSA_KEY_SIZE=4096
EASYRSA_CA_EXPIRE=3650
EASYRSA_CERT_EXPIRE=825

# ─── Web Management UI ────────────────────────────────────────────────────────
# Port the web UI is accessible on (default: 8080, bound to 127.0.0.1 —
# front it with a TLS reverse proxy or override deliberately for trusted LANs)
WEBAPP_PORT=8080

# ─── Admin authentication (local — no external auth service) ───────────────────
# Single admin account for the web UI + a static bearer token for /api/v1.
# Generate:
#   ADMIN_PASSWORD_HASH: python -c "from werkzeug.security import generate_password_hash as g; print(g('YOUR-PASSWORD'))"
#   API_TOKEN:            python -c "import secrets; print(secrets.token_hex(32))"
#   FLASK_SECRET_KEY:     python -c "import secrets; print(secrets.token_hex(32))"
#
# IMPORTANT — ALWAYS SINGLE-QUOTE ADMIN_PASSWORD_HASH in this file:
#   ADMIN_PASSWORD_HASH='scrypt:32768:8:1$salt$hash'
# The hash contains '$' separators. docker-compose INTERPOLATES $VAR
# sequences inside .env values, silently replacing them with empty
# strings — an unquoted hash gets corrupted and every login fails.
# Single quotes make compose take the value literally.
ADMIN_EMAIL=admin
ADMIN_PASSWORD_HASH=''
API_TOKEN=
FLASK_SECRET_KEY=

# Set to 1 for development only
FLASK_DEBUG=0

# Secure default: authentication is ON (0). The webapp refuses to boot
# unless ADMIN_PASSWORD_HASH, API_TOKEN and a strong FLASK_SECRET_KEY are
# configured. Set to 1 ONLY when the UI is behind a trusted reverse
# proxy/firewall and not publicly reachable.
AUTH_DISABLED=0

# ─── Static Routes ────────────────────────────────────────────────────────────
# Comma-separated list of CIDR networks for split-tunnel routing through
# the VPN. When set, ONLY these networks route through the VPN
# (redirect-gateway is removed); other traffic bypasses it.
# When empty (default), all traffic is redirected through the VPN.
# Example: 80.50.43.0/24,192.168.1.0/24
OPENVPN_STATIC_ROUTES=
